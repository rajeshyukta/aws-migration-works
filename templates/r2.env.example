# Copy to E:\workspace\aws-setup-and-migrations\private-data\r2.env (gitignored)
# Never commit real values.

# Cloudflare Account ID (32-char hex) or full S3 endpoint URL
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=nxtmngr-test

# R2 S3 Access Key ID + Secret Access Key (from Cloudflare R2 -> Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: restic repository encryption password (if set when creating the NMC backup target)
RESTIC_PASSWORD=
