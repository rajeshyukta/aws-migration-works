# NextDP Mail — Standalone AWS Lightsail .env reference (NO SECRETS)
# Live file on VM: /opt/nextdp/config/.env (generated by 02-remote-install.sh)

APP_NAME="NextDP Mail"
APP_ENV=production
APP_DEBUG=false
APP_PORT=8080
APP_URL=https://mail.nextdp.com
APP_KEY=<generated-64-hex>

RAPIDGO_MODE=all

# Local PostgreSQL 16
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nextdp_mail
DB_USER=nextdp_mail
DB_PASSWORD=<generated>
DB_SSL_MODE=disable

# Local Redis 7
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<generated>

# Sessions, Cache, Queue
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECRET=<generated-64-hex>
CACHE_DRIVER=redis
CACHE_PREFIX=raimail_
QUEUE_DRIVER=redis
QUEUE_DEFAULT=default
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY=30
QUEUE_TIMEOUT=60
QUEUE_POLL_INTERVAL=3

# JWT & Migration encryption
JWT_SECRET=<generated-64-hex>
JWT_EXPIRY=3600
MIGRATION_ENCRYPTION_KEY=<generated-64-hex>

# Super Admin seed fallback (used only if running db:seed on a fresh DB)
SUPER_ADMIN_EMAIL=admin@nextdp.com
SUPER_ADMIN_PASSWORD=<change-if-seeding>

# Mail listeners & Caddy-synced TLS
MAIL_FROM_ADDRESS=noreply@nextdp.com
SMTP_DOMAIN=mx.nextdp.com
SMTP_LISTEN=0.0.0.0:25
SMTP_TLS_LISTEN=0.0.0.0:465
SMTP_SUBMISSION_LISTEN=0.0.0.0:587
SMTP_MAX_MESSAGE_BYTES=26214400
SMTP_TLS_CERT=/opt/nextdp/config/tls/mail.nextdp.com.crt
SMTP_TLS_KEY=/opt/nextdp/config/tls/mail.nextdp.com.key
IMAP_LISTEN=0.0.0.0:143
IMAP_TLS_LISTEN=0.0.0.0:993
POP3_LISTEN=0.0.0.0:110
POP3_TLS_LISTEN=0.0.0.0:995

# Local Storage
STORAGE_DRIVER=local
STORAGE_PATH=/opt/nextdp/storage
STORAGE_LOCAL_PATH=/opt/nextdp/storage/uploads

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
