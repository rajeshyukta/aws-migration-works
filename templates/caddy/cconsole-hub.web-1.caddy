# Managed: CConsole Hub (reseller-mw, CodeIgniter 4 + 2 SPAs) on Web-1 (3.6.143.66).
# Installed by scripts/web-1-vm/06-deploy-cconsole-hub.ps1 -Phase sites (only after DNS points here).

(cchub_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(cchub_log) {
	log {
		output file /var/log/caddy/cconsole-hub.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

api.hub.cconsole.com, sandbox.hub.cconsole.com {
	root * /srv/phpapps/cconsole-hub/ci4-app/public
	encode zstd gzip
	import cchub_headers

	@blocked path /.* *.env* *.log *.sql *.bak
	respond @blocked 403

	php_fastcgi unix//run/php/app-cconsole-hub.sock
	file_server
	import cchub_log
}

hub.cconsole.com {
	root * /srv/phpapps/cconsole-hub/frontend/tenant/dist
	encode zstd gzip
	import cchub_headers
	header X-Frame-Options "SAMEORIGIN"
	try_files {path} /index.html
	file_server
	import cchub_log
}

admin.hub.cconsole.com {
	root * /srv/phpapps/cconsole-hub/frontend/admin/dist
	encode zstd gzip
	import cchub_headers
	header X-Frame-Options "SAMEORIGIN"
	try_files {path} /index.html
	file_server
	import cchub_log
}

docs.hub.cconsole.com {
	root * /srv/phpapps/cconsole-hub/ci4-app/public/docs
	encode zstd gzip
	header {
		Access-Control-Allow-Origin "*"
		Cache-Control "public, max-age=300"
		-Server
	}
	file_server
	import cchub_log
}
